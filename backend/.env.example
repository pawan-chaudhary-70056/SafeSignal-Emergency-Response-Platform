# Copy to .env and adjust for your local environment.
NODE_ENV="development"
PORT="4100"

# Matches docker-compose.yml (PostgreSQL published on 55432).
DATABASE_URL="postgresql://safesignal:safesignal@localhost:55432/safesignal?schema=public"

# Matches docker-compose.yml (Redis published on 6381, AOF enabled).
REDIS_URL="redis://127.0.0.1:6381"

SESSION_TTL_DAYS="7"

# Express "trust proxy".
# Behind a reverse proxy or load balancer set the number of trusted hops
# (for example "1"), or a subnet/name list such as "loopback" or "10.0.0.0/8".
# Without it, req.ip is the proxy address (rate limits would be shared by all
# clients) and req.protocol stays http (secure-cookie detection fails).
TRUST_PROXY="loopback"

# Cookies are HttpOnly + SameSite=Lax by default and become Secure
# automatically when NODE_ENV=production. Override only when required:
# COOKIE_SECURE="true"
# COOKIE_SAME_SITE="lax"      # lax | strict | none (none forces Secure)
# COOKIE_DOMAIN=".example.com"

# NFR-034 data retention (docs/07-security/data-retention-policy.md).
# Only notifications and expired sessions are swept; incident, assignment,
# evidence, and audit records are never auto-deleted.
# RETENTION_NOTIFICATION_DAYS="90"
# RETENTION_SESSION_DAYS="30"
# RETENTION_SWEEP_INTERVAL_HOURS="1"

# Comma-separated browser origins allowed for CORS and CSRF checks.
FRONTEND_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# Production seeding only (scripts/seed-production.ts). Leave unset for local
# development; the demo seed already provides an admin account.
# ADMIN_EMAIL="ops@example.com"
# ADMIN_PASSWORD="use-a-long-random-password"
# ADMIN_FULL_NAME="Operations Administrator"
