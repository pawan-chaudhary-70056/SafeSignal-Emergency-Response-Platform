// SafeSignal database schema.
// Source: docs/05-database-design/database-schema-and-relationships.md
// Roles and users exist first because role identification is part of login.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IncidentStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
  CANCELLED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  REASSIGNED
  COMPLETED
}

enum ResponderAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

/// Lifecycle of a durable background job. PENDING jobs become PROCESSING when
/// claimed, then DONE on success or FAILED once retries are exhausted.
enum BackgroundJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  users User[]
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  roleId        String        @db.Uuid
  fullName      String        @db.VarChar(120)
  email         String        @unique @db.VarChar(255)
  passwordHash  String        @db.VarChar(255)
  phone         String?       @db.VarChar(30)
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  role                Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions            Session[]
  incidents           Incident[]              @relation("CitizenIncidents")
  responderProfile    ResponderProfile?
  statusChanges       IncidentStatusHistory[] @relation("StatusChangedBy")
  receivedAssignments Assignment[]            @relation("AssignedResponder")
  createdAssignments  Assignment[]            @relation("AssignedBy")
  uploadedEvidence    Evidence[]              @relation("EvidenceUploadedBy")
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([roleId])
  @@index([accountStatus])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmergencyCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  incidents Incident[]
}

model Incident {
  id                  String           @id @default(uuid()) @db.Uuid
  serialNumber        Int              @unique @default(autoincrement())
  referenceNumber     String           @unique @db.VarChar(40)
  citizenId           String           @db.Uuid
  categoryId          String           @db.Uuid
  description         String
  contactInformation  String?          @db.VarChar(255)
  idempotencyKey      String?          @db.VarChar(64)
  latitude            Float?
  longitude           Float?
  locationDescription String?          @db.VarChar(500)
  priority            IncidentPriority @default(MEDIUM)
  status              IncidentStatus   @default(SUBMITTED)
  rejectionReason     String?
  resolutionNotes     String?
  resolvedAt          DateTime?        @db.Timestamptz(6)
  closedAt            DateTime?        @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)

  citizen       User                    @relation("CitizenIncidents", fields: [citizenId], references: [id], onDelete: Restrict)
  category      EmergencyCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusHistory IncidentStatusHistory[]
  assignments   Assignment[]
  evidence      Evidence[]

  @@unique([citizenId, idempotencyKey])
  @@index([citizenId, createdAt])
  @@index([status, priority, createdAt])
  @@index([categoryId])
}

model IncidentStatusHistory {
  id             String          @id @default(uuid()) @db.Uuid
  incidentId     String          @db.Uuid
  changedById    String?         @db.Uuid
  previousStatus IncidentStatus?
  newStatus      IncidentStatus
  reason         String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)

  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  changedBy User?    @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([changedById])
}

model ResponderProfile {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @unique @db.Uuid
  responderType      String                @db.VarChar(80)
  availabilityStatus ResponderAvailability @default(AVAILABLE)
  operationalNotes   String?
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([availabilityStatus])
}

model Assignment {
  id                 String           @id @default(uuid()) @db.Uuid
  incidentId         String           @db.Uuid
  responderId        String           @db.Uuid
  assignedById       String           @db.Uuid
  status             AssignmentStatus @default(PENDING)
  assignmentNote     String?
  rejectionReason    String?
  reassignmentReason String?
  assignedAt         DateTime         @default(now()) @db.Timestamptz(6)
  acceptedAt         DateTime?        @db.Timestamptz(6)
  completedAt        DateTime?        @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  responder  User     @relation("AssignedResponder", fields: [responderId], references: [id], onDelete: Restrict)
  assignedBy User     @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([incidentId, status])
  @@index([responderId, status])
  @@index([assignedById])
}

model Evidence {
  id           String   @id @default(uuid()) @db.Uuid
  incidentId   String   @db.Uuid
  uploadedById String   @db.Uuid
  fileName     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  sizeBytes    Int
  content      Bytes
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@index([uploadedById])
}

/// NFR-054: durable background jobs. Work that must not block a user request
/// (or that failed inline and needs a retry) is enqueued here and processed by
/// the worker loop with capped exponential-backoff retries.
model BackgroundJob {
  id          String              @id @default(uuid()) @db.Uuid
  type        String              @db.VarChar(50)
  payload     Json
  status      BackgroundJobStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  lastError   String?
  runAfter    DateTime            @default(now()) @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  @@index([status, runAfter])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @db.Uuid
  type        String    @db.VarChar(60)
  title       String    @db.VarChar(140)
  message     String    @db.VarChar(500)
  entityType  String    @db.VarChar(40)
  entityId    String?   @db.VarChar(100)
  isRead      Boolean   @default(false)
  readAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([createdAt])
}
