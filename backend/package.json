    "db:reset:demo": "tsx scripts/reset-demo.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "express": "^5.1.0",
    "redis": "^6.3.1",
