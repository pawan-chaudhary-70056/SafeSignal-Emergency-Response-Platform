# Test environment, loaded by `npm test` via node --env-file.
# The database name must end in _test: the test suite truncates every table.
NODE_ENV="test"
DATABASE_URL="postgresql://safesignal:safesignal@127.0.0.1:55432/safesignal_test?schema=public"

# Separate Redis database index so development rate-limit counters are untouched.
REDIS_URL="redis://127.0.0.1:6381/1"

SESSION_TTL_DAYS="7"
TRUST_PROXY="loopback"
FRONTEND_ORIGINS="http://127.0.0.1:5174,http://localhost:5174"
